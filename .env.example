# Copy to .env and fill in real values. Never commit the resulting .env file.

# --- Kaggle (optional; data/fetch.py falls back to a public mirror) ---
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# --- MLflow ---
# Use a remote tracking server in production, or a file:// path for local runs.
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT=telco-churn
MLFLOW_REGISTERED_MODEL=telco-churn-classifier

# --- Training hyperparameters (override defaults in src/config.py) ---
LEARNING_RATE=0.001
WEIGHT_DECAY=0.00001
BATCH_SIZE=64
EPOCHS=30
PATIENCE=5
NUM_WORKERS=0
TRAIN_DEVICE=auto

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_MODEL_STAGE=Production
